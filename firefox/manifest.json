{
  "manifest_version": 3,
  "name": "Fahrtrichtung",
  "version": "1.2.0",
  "description": "__MSG_extDescription__",
  "default_locale": "de",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://www.fernbahn.de/*",
    "https://*.bahn.de/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "scripts": [
      "utils.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fahrtrichtung@extension",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "technicalAndInteraction"
        ]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bahn.de/*"
      ],
      "js": [
        "booking.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
