{
  "private": true,
  "name": "fahrtrichtung-ci",
  "description": "CI/CD tooling for Fahrtrichtung browser extension",
  "scripts": {
    "test:headless": "node run-tests-headless.mjs",
    "test:e2e": "node test-e2e-live.mjs",
    "test:record": "node test-reference-record.mjs",
    "test:compare": "node test-reference-compare.mjs --mode hint",
    "test:compare:scan": "node test-reference-compare.mjs --mode scan --sample 10",
    "test:unit:bahnde": "node test-bahnde-unit.mjs",
    "test": "npm run test:headless && npm run test:unit:bahnde && npm run test:unit:booking",
    "test:unit:booking": "node test-booking-unit.mjs"
  },
  "devDependencies": {
    "puppeteer": "^24.0.0",
    "chrome-webstore-upload-cli": "^3.0.0",
    "web-ext": "^8.0.0"
  }
}
